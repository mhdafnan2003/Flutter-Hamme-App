NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173,https://your-frontend-project.vercel.app
PUBLIC_BASE_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=hamme/profile
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ENABLE_SOCKETS=false
PENDING_TTL_SECONDS=60
# false: anonymous votes count only. true: show blurred cards and allow vote-back.
ANONYMOUS_VOTE_BACK_ENABLED=false

# ---- In-app purchases (Google Play billing) ----
# Product ids (comma separated) that grant Pro. Must match Play Console.
PRO_PRODUCT_IDS=hamme_pro_weekly
# Your Android application id (package name), e.g. com.hamme.app
ANDROID_PACKAGE_NAME=
# Google Play service account credentials for purchase verification.
# Provide ONE of the following:
#   - GOOGLE_PLAY_SERVICE_ACCOUNT_JSON: the full service-account JSON (single line)
#   - GOOGLE_PLAY_SERVICE_ACCOUNT_FILE: absolute path to the JSON key file
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=

# Google Play Real-time Developer Notifications (Cloud Pub/Sub push).
# Audience must exactly match the audience configured on the push subscription,
# normally: https://your-api.example.com/api/v1/billing/google-play/rtdn
GOOGLE_PLAY_RTDN_AUDIENCE=
# Email of the service account selected under Pub/Sub push authentication.
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# ---- In-app purchases (Apple App Store subscriptions) ----
# Add these only to your host's encrypted environment variables. Never commit
# the downloaded SubscriptionKey_*.p8 file or its contents.
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_BUNDLE_ID=com.akash.hammeapp
# Numeric Apple ID from App Store Connect > App Information.
APPLE_IAP_APP_ID=
# Base64-encoded contents of SubscriptionKey_<KEY_ID>.p8.
APPLE_IAP_PRIVATE_KEY_BASE64=

# ---- Admin panel ----
# Shared secret for the admin plan-manager at /api/v1/admin.
# Leave empty to disable the admin API entirely.
ADMIN_API_KEY=
