# Required: your backend API base URL. Production builds (vite build) fail without it.
VITE_API_BASE_URL=https://your-backend-project.vercel.app/api/v1

# Required for iOS: your App Store URL (e.g. https://apps.apple.com/app/id<YOUR_APP_ID>)
# Android uses Play Store automatically with the install referrer for token passing.
# iOS note: the token cannot survive a fresh iOS install — the App Store has no referrer API.
VITE_APP_STORE_URL=https://apps.apple.com/app/id<YOUR_APP_ID>

# Optional: custom URL scheme the iOS app opens with (default: hamme). Set to
# hamme2 on the web deployment that serves the NEW iOS listing (ios2 branch);
# it must match CFBundleURLSchemes in ios/Runner/Info.plist. Android is unaffected.
# NOTE: set this in the host's environment (Vercel); .env is not tracked in git.
VITE_IOS_APP_SCHEME=

# Optional: must match PENDING_TTL_SECONDS in the backend .env (default: 180)
VITE_PENDING_TTL_SECONDS=180
